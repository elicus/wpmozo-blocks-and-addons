{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpmozo/image-accordion",
  "version": "1.0.0",
  "title": "Image Accordion",
  "category": "wpmozo",
  "icon": "smiley",
  "description": "The Image Accordion block enables you to turn simple images into stylish one and show content on them when users hover or click on them",
  "allowedBlocks": [
    "wpmozo/image-accordion-item"
  ],
  "example": {},
  "supports": {
    "html": false,
    "anchor": false,
    "customClassName": false
  },
  "attributes": {
    "ID": {
      "type": "string"
    },
    "className": {
      "type": "string"
    },
    "accordionTrigger": {
      "type": "string",
      "default": "hover"
    },
    "accordionOrientation": {
      "type": "string",
      "default": "horizontal"
    },
    "contentAlignment": {
      "type": "string",
      "default": "center"
    },
    "inactiveState": {
      "type": "array",
      "default": []
    },
    "accordionSpacing": {
      "type": "string"
    },
    "activeAccordionSize": {
      "number": "string",
      "default": 4
    },
    "activeAccordion": {
      "type": "number"
    },
    "accordionTransitionDuration": {
      "type": "number",
      "default": 500
    },
    "accordionHeight": {
      "type": "string",
      "default": "350px"
    },
    "textColor": {
      "type": "string",
      "default": "dark"
    },
    "textAlignment": {
      "type": "string"
    },
    "titleColor": {
      "type": "string"
    },
    "titleHoverColor": {
      "type": "string"
    },
    "titleAlign": {
      "type": "string"
    },
    "titleLavel": {
      "type": "string",
      "default": "h4"
    },
    "titleFontSize": {
      "type": "string",
      "default": "18px"
    },
    "titleFontAppearance": {
      "type": "object",
      "fontStyle": {
        "type": "string"
      },
      "fontWeight": {
        "type": "string"
      },
      "default": {
        "fontStyle": "",
        "fontWeight": ""
      }
    },
    "titleLetterSpacing": {
      "type": "string"
    },
    "titleDecoration": {
      "type": "string"
    },
    "titleLetterCase": {
      "type": "string"
    },
    "titleLineHeight": {
      "type": "string"
    },
    "titleHoverFontSize": {
      "type": "string"
    },
    "titleHoverLetterSpacing": {
      "type": "string"
    },
    "titleHoverDecoration": {
      "type": "string"
    },
    "titleHoverLetterCase": {
      "type": "string"
    },
    "titleHoverLineHeight": {
      "type": "string"
    },
    "titleHoverFontAppearance": {
      "type": "object",
      "default": {
        "fontStyle": "",
        "fontWeight": ""
      }
    },
    "titlepadding": {
      "type": "object"
    },
    "titlemargin": {
      "type": "object"
    },
    "descriptionColor": {
      "type": "string"
    },
    "descriptionHoverColor": {
      "type": "string"
    },
    "descriptionAlign": {
      "type": "string"
    },
    "descriptionFontSize": {
      "type": "string",
      "default": "18px"
    },
    "descriptionFontAppearance": {
      "type": "object",
      "fontStyle": {
        "type": "string"
      },
      "fontWeight": {
        "type": "string"
      },
