{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpmozo/image-stack-child",
  "version": "0.1.0",
  "title": "Image Stack Item",
  "category": "wpmozo",
  "icon": "smiley",
  "description": "Image Stack Item add the image or icon to an interactive stacked layout that expands on hover.",
  "example": {},
  "supports": {
    "html": false,
    "customClassName": false
  },
  "parent": [
    "wpmozo/image-stack"
  ],
  "attributes": {
    "parentAtts": {
      "type": "object"
    },
    "ID": {
      "type": "string"
    },
    "className": {
      "type": "string"
    },
    "image": {
      "type": "object"
    },
    "stackType": {
      "type": "string",
      "default": "image"
    },
    "stackIcon": {
      "type": "string",
      "default": "fas fa-arrow-right"
    },
    "tooltipText": {
      "type": "string"
    },
    "itemBackground": {
      "type": "string"
    },
    "itemHoverBackground": {
      "type": "string"
    },
    "itemBGGradient": {
      "type": "string"
    },
    "itemHoverBGGradient": {
      "type": "string"
    },
    "imageborder": {
      "type": "object"
    },
    "imageHoverborder": {
      "type": "object"
    },
    "imageborderRadius": {
      "type": "object"
    },
    "imageHoverborderRadius": {
      "type": "object"
    },
    "iconborder": {
      "type": "object"
    },
    "iconHoverborder": {
      "type": "object"
    },
    "iconborderRadius": {
      "type": "object"
    },
    "iconHoverborderRadius": {
      "type": "object"
    }
  },
  "textdomain": "wpmozo-blocks-and-addons",
  "editorScript": "file:./index.js",
  "editorStyle": [
    "wpmozo-blocks-and-addons-fontawesome-style",
    "file:./index.css"
  ],
  "style": [
    "wpmozo-blocks-and-addons-fontawesome-style",
    "file:./style-index.css"
  ]
}