{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpmozo/floating-image-item",
  "version": "1.1.0",
  "title": "Floating Image Item",
  "category": "wpmozo",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "example": {},
  "parent": [
    "wpmozo/floating-image"
  ],
  "supports": {
    "html": false,
    "shadow": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "ID": {
      "type": "string"
    },
    "image": {
      "type": "object"
    },
    "imagewidth": {
      "type": "string",
      "default": "200px"
    },
    "imageheight": {
      "type": "string"
    },
    "altText": {
      "type": "string",
      "default": ""
    },
    "horizontalAlign": {
      "type": "string"
    },
    "verticalAlign": {
      "type": "string"
    },
    "animationEffect": {
      "type": "string",
      "default": "up_down"
    },
    "animationDelay": {
      "type": "number",
      "default": 0
    },
    "animationDuration": {
      "type": "number",
      "default": 4000
    },
    "animationRepeat": {
      "type": "string",
      "default": "infinite"
    },
    "speedCurve": {
      "type": "string"
    },
    "imageborderRadius": {
      "type": "string"
    },
    "imageborder": {
      "type": "object"
    }
  },
  "textdomain": "wpmozo-blocks-and-addons",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}