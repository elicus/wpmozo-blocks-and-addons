{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "wpmozo/masonry-gallery",
    "version": "0.1.0",
    "title": "Masonry Gallery",
    "category": "wpmozo",
    "icon": "smiley",
    "description": "Design a customizable image gallery with a masonry layout for multiple photos.",
    "example": {},
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false
	},
	"attributes": {
		"ID": { "type": "string" },
		"className": { "type": "string" },
		"wrapCustomClass": { "type": "string", "default": "" },
		"images": {
			"type": "array",
			"default": [],
			"source": "query",
			"selector": ".wpmozo-blocks-and-addons-gallery--item",
			"query": {
				"url": {
					"source": "attribute",
					"selector": "img",
					"attribute": "src"
				}
			}
		},
		"images_data": {
			"type": "array"
		},
		"customGutterSize": {"type": "number", "default": 15},
		"sizeSlug": {"type": "string"},
		"numberOfColumns": {"type": "number","default": 3},
		"showCaption": { "type": "boolean", "default": false },
		"showLightbox": { "type": "boolean", "default": false },
		"enableOverlay": {"type": "boolean","default": false},
		"overlayBackgroundColor": {"type": "string"},
		"overlayIconSize": {"type": "number"},
		"overlayIconColor": {"type": "string"},
		"overlayIcon": {"type": "string"},
		"imageborder": { "type": "object" },
		"imagehoverborder": { "type": "object" },
		"imageborderRadius": { "type": "object" },
		"imagehoverborderRadius": { "type": "object" },
		"captionColor": { "type": "string" },
		"captionHoverColor": { "type": "string" },
		"captionFontSize": { "type": "string" },
		"captionHoverFontSize": { "type": "string" },
		"lightboxBackgroundColor": {"type": "string"},
		"lightboxHoverBackgroundColor": {"type": "string"},
		"lightboxExitIconColor": {"type": "string"},
		"lightboxHoverExitIconColor": {"type": "string"},
		"lightboxArrowColor": {"type": "string"},
		"lightboxHoverArrowColor": {"type": "string"}
	},

    "textdomain": "wpmozo-blocks-and-addons",
    "editorScript": "file:./index.js",
	"editorStyle": ["wpmozo-blocks-and-addons-fontawesome-style","file:./index.css"],
    "style": ["wpmozo-blocks-and-addons-fontawesome-style", "wpmozo-blocks-and-addons-magnificPopup-style","file:./style-index.css"],
	"script": ["wpmozo-blocks-and-addons-isotope-script","wpmozo-blocks-and-addons-imagesloaded-script","wpmozo-blocks-and-addons-magnificPopup-script","file:./script.js"],
	"render": "file:./render.php"
}
