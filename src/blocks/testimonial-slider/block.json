{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpmozo/testimonial-slider",
	"version": "0.1.0",
	"title": "Testimonial Slider",
	"category": "wpmozo",
	"icon": "smiley",
	"description": "Testimonial slider to use to display testimonials.",
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"ID": { "type": "string" },

		"layout": { "type": "string", "default": "layout1" },
		"postsToShow": { "type": "number", "default": 5 },
		"postOrder": { "type": "string", "default": "desc" },
		"postOrderBy": { "type": "string", "default": "date" },
		"includesCategories": { "type": "array", "default": [] },
		"noResultText": { "type": "string", "default": "The testimonials you requested could not be found. Try changing your module settings or create some new testimonials." },

		"showRating": { "type": "boolean", "default": true },
		"starFontSize": { "type": "number", "default": 28 },
		"starFilledColor": { "type": "string", "default": "#fac917" },
		"starEmptyColor": { "type": "string", "default": "#fac917" },
		"showAuthorImage": { "type": "boolean", "default": true },
		"showDesignation": { "type": "boolean", "default": true },
		"showCompany": { "type": "boolean", "default": true },

		"slideEffect": { "type": "string", "default": "slide" },
		"slidesPerView": { "type": "number", "default": 1 },
		"slidesPerViewTablet": { "type": "number", "default": 1 },
		"slidesPerViewMobile": { "type": "number", "default": 1 },
		"slidesPerGroup": { "type": "number", "default": 1 },
		"slidesPerGroupTablet": { "type": "number", "default": 1 },
		"slidesPerGroupMobile": { "type": "number", "default": 1 },
		"spaceBetweenSlides": { "type": "number", "default": 20 },
		"spaceBetweenSlidesTablet": { "type": "number", "default": 20 },
		"spaceBetweenSlidesMobile": { "type": "number", "default": 20 },
		"equalHeigh": { "type": "boolean", "default": false },
		"enableLoop": { "type": "boolean", "default": false },
		"autoplay": { "type": "boolean", "default": true },
		"enableLinearTrans": { "type": "boolean", "default": false },
		"autoplayDelay": { "type": "number", "default": 3000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"transDuration": { "type": "number", "default": 1000 },

		"showArrows": { "type": "boolean", "default": false },
		"prevArrowIcon": { "type": "string", "default": "" },
		"nextArrowIcon": { "type": "string", "default": "" },
		"showArrowOnHover": { "type": "boolean", "default": false },
		"arrowsPosition": { "type": "string", "default": "inside" },
		"showControlDot": { "type": "boolean", "default": false },
		"controlDotStyle": { "type": "string", "default": "solid_dot" },
		"enableDynamicDots": { "type": "boolean", "default": false },

		"globalTextAlign": { "type": "string", "default": "center" },
		"bodyColor": { "type": "string" },
		"bodyFontSize": { "type": "string" },
		"bodyLetterSpacing": { "type": "string" },
		"bodyDecoration": { "type": "string" },
		"bodyLetterCase": { "type": "string" },
		"bodyLineHeight": { "type": "string" },
		"bodyFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"bodyFontStyle": { "type": "string" },
		"bodyFontWeight": { "type": "string" },

		"authorNameColor": { "type": "string" },
		"authorNameFontSize": { "type": "string" },
		"authorNameLetterSpacing": { "type": "string" },
		"authorNameDecoration": { "type": "string" },
		"authorNameLetterCase": { "type": "string" },
		"authorNameLineHeight": { "type": "string" },
		"authorNameFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"authorNameFontStyle": { "type": "string" },
		"authorNameFontWeight": { "type": "string" },

		"designationColor": { "type": "string" },
		"designationFontSize": { "type": "string" },
		"designationLetterSpacing": { "type": "string" },
		"designationDecoration": { "type": "string" },
		"designationLetterCase": { "type": "string" },
		"designationLineHeight": { "type": "string" },
		"designationFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"designationFontStyle": { "type": "string" },
		"designationFontWeight": { "type": "string" },
		
		"companyNameColor": { "type": "string" },
		"companyNameFontSize": { "type": "string" },
		"companyNameLetterSpacing": { "type": "string" },
		"companyNameDecoration": { "type": "string" },
		"companyNameLetterCase": { "type": "string" },
		"companyNameLineHeight": { "type": "string" },
		"companyNameFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"companyNameFontStyle": { "type": "string" },
		"companyNameFontWeight": { "type": "string" },

		"showOpenQuoteIcon": { "type": "boolean", "default": true },
		"openQuoteIconSize": { "type": "number", "default": 42 },
		"openQuoteIconColor": { "type": "string", "default": "" },
		"showCloseQuoteIcon": { "type": "boolean", "default": false },
		"closeQuoteIconSize": { "type": "number", "default": 42 },
		"closeQuoteIconColor": { "type": "string", "default": "" },

		"sliderpadding": { "type": "object" },
		"arrowFontSize": { "type": "number", "default": "24" },
		"arrowColor": { "type": "string", "default": "" },
		"arrowBackground": { "type": "string", "default": "" },
		"arrowsborder": { "type": "object" },
        "arrowsborderRadius": { "type": "string" },

		"metaSeparatorColor": { "type": "string", "default": "#dddddd" },
		"containerpadding": { "type": "object" },
		"testimonialpadding": { "type": "object" },
		"testimonialBackground": { "type": "string" },
		"testimonialBGGradient": { "type": "string" },
		"testimonialborder": { "type": "object" },
        "testimonialborderRadius": { "type": "string" },

		"authorImageborder": { "type": "object" },
        "authorImageborderRadius": { "type": "string" }
	},
	"textdomain": "wpmozo-blocks-and-addons",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"script": [ "wpmozo-blocks-and-addons-swiper-script", "file:./script.js" ],
	"render": "file:./render.php"
}
