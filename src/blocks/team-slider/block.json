{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpmozo/team-slider",
	"version": "0.1.0",
	"title": "Team Slider",
	"category": "wpmozo",
	"icon": "smiley",
	"description": "Showcase team members or staff in an amazing slider. Perfect for introducing your team or personnel on your website.",
	"example": {},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"attributes": {
		"ID": { "type": "string" },
		"className": { "type": "string" },

		"layout": { "type": "string", "default": "layout1" },

		"postsNumber": { "type": "number", "default": 10 },
		"postOrder": { "type": "string", "default": "desc" },
		"postOrderBy": { "type": "string", "default": "date" },
		"includesCategories": { "type": "array", "default": [] },
		"noResultText": { "type": "string", "default": "The team member you requested could not be found. Try changing your module settings or create some new team members." },

		"showShortDesc": { "type": "boolean", "default": true },
		"showDesignation": { "type": "boolean", "default": true },
		"showSocialIcon": { "type": "boolean", "default": true },
		"socialIconTarget": { "type": "string", "default": "external" },
		"showSkills": { "type": "boolean", "default": false },

		"enableLink": { "type": "boolean", "default": false },
		"linkType": { "type": "string", "default": "item" },
		"linkButtonText": { "type": "string", "default": "Read more" },
		"usePopup": { "type": "boolean", "default": false },
		"linkTarget": { "type": "string", "default": "same" },
		"displayInPopup": { "type": "array", "default": [ "image", "designation", "social_icons", "content", "skills_bars" ] },

		"slideEffect": { "type": "string", "default": "slide" },
		"slidesPerView": { "type": "number", "default": 3 },
		"slidesPerViewTablet": { "type": "number", "default": 2 },
		"slidesPerViewMobile": { "type": "number", "default": 1 },
		"slidesPerGroup": { "type": "number", "default": 1 },
		"slidesPerGroupTablet": { "type": "number", "default": 1 },
		"slidesPerGroupMobile": { "type": "number", "default": 1 },
		"spaceBetweenSlides": { "type": "number", "default": 20 },
		"spaceBetweenSlidesTablet": { "type": "number", "default": 20 },
		"spaceBetweenSlidesMobile": { "type": "number", "default": 20 },

		"enableCoverflowShadow": { "type": "boolean", "default": false },
		"coverflowShadowColor": { "type": "string", "default": "#cccccc" },
		"coverflowRotate": { "type": "number", "default": 40 },
		"coverflowDepth": { "type": "number", "default": 100 },
		"equalHeight": { "type": "boolean", "default": true },
		"autoHeight": { "type": "boolean", "default": false },
		"enableLoop": { "type": "boolean", "default": false },
		"autoplay": { "type": "boolean", "default": true },
		"enableLinearTrans": { "type": "boolean", "default": false },
		"autoplayDelay": { "type": "number", "default": 3000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"transDuration": { "type": "number", "default": 1000 },

		"showArrows": { "type": "boolean", "default": false },
		"prevArrowIcon": { "type": "string", "default": "" },
		"nextArrowIcon": { "type": "string", "default": "" },
		"showArrowOnHover": { "type": "boolean", "default": false },
		"arrowsPosition": { "type": "string", "default": "inside" },
		"showControlDot": { "type": "boolean", "default": false },
		"controlDotStyle": { "type": "string", "default": "solid_dot" },
		"enableDynamicDots": { "type": "boolean", "default": false },
		"controlDotColorActive": { "type": "string", "default": "#000000" },
		"controlDotColorInactive": { "type": "string", "default": "#cccccc" },

		"imageHeight": { "type": "number" },
		"imageborder": { "type": "object" },
		"imageborderRadius": { "type": "string" },

		"nameLevel": { "type": "string", "default": "h2" },
		"nameAlign": { "type": "string" },
		"nameColor": { "type": "string" },
		"nameFontSize": { "type": "string", "default": "24px" },
		"nameLetterSpacing": { "type": "string" },
		"nameDecoration": { "type": "string" },
		"nameLetterCase": { "type": "string" },
		"nameLineHeight": { "type": "string" },
		"nameFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"nameFontStyle": { "type": "string" },
		"nameFontWeight": { "type": "string" },

		"designationLevel": { "type": "string", "default": "h4" },
		"designationAlign": { "type": "string" },
		"designationColor": { "type": "string" },
		"designationFontSize": { "type": "string", "default": "20px" },
		"designationLetterSpacing": { "type": "string" },
		"designationDecoration": { "type": "string" },
		"designationLetterCase": { "type": "string" },
		"designationLineHeight": { "type": "string" },
		"designationFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"designationFontStyle": { "type": "string" },
		"designationFontWeight": { "type": "string" },

		"descriptionAlign": { "type": "string" },
		"descriptionColor": { "type": "string" },
		"descriptionFontSize": { "type": "string", "default": "20px" },
		"descriptionLetterSpacing": { "type": "string" },
		"descriptionDecoration": { "type": "string" },
		"descriptionLetterCase": { "type": "string" },
		"descriptionLineHeight": { "type": "string" },
		"descriptionFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"descriptionFontStyle": { "type": "string" },
		"descriptionFontWeight": { "type": "string" },

		"skillAlign": { "type": "string" },
		"skillColor": { "type": "string" },
		"skillFontSize": { "type": "string", "default": "20px" },
		"skillLetterSpacing": { "type": "string" },
		"skillDecoration": { "type": "string" },
		"skillLetterCase": { "type": "string" },
		"skillLineHeight": { "type": "string" },
		"skillFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"skillFontStyle": { "type": "string" },
		"skillFontWeight": { "type": "string" },

		"barHeight": { "type": "number", "default": 10 },
		"emptyBarColor": { "type": "string", "default": "#cccccc" },
		"filledBarColor": { "type": "string", "default": "#5600b7" },

		"socialSeparatorColor": { "type": "string", "default": "#cccccc" },
		"socialSeparatorSize": { "type": "number", "default": 1 },
		"socialIconSize": { "type": "number", "default": 16 },
		"socialIconColor": { "type": "string" },
		"socialIconBgColor": { "type": "string" },
		"socialIconAlign": { "type": "string", "default": "center" },

		"popupNameLevel": { "type": "string", "default": "h2" },
		"popupNameAlign": { "type": "string" },
		"popupNameColor": { "type": "string" },
		"popupNameFontSize": { "type": "string", "default": "24px" },
		"popupNameLetterSpacing": { "type": "string" },
		"popupNameDecoration": { "type": "string" },
		"popupNameLetterCase": { "type": "string" },
		"popupNameLineHeight": { "type": "string" },
		"popupNameFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"popupNameFontStyle": { "type": "string" },
		"popupNameFontWeight": { "type": "string" },

		"popupDesignationAlign": { "type": "string" },
		"popupDesignationColor": { "type": "string" },
		"popupDesignationFontSize": { "type": "string", "default": "20px" },
		"popupDesignationLetterSpacing": { "type": "string" },
		"popupDesignationDecoration": { "type": "string" },
		"popupDesignationLetterCase": { "type": "string" },
		"popupDesignationLineHeight": { "type": "string" },
		"popupDesignationFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"popupDesignationFontStyle": { "type": "string" },
		"popupDesignationFontWeight": { "type": "string" },

		"popupDescriptionAlign": { "type": "string" },
		"popupDescriptionColor": { "type": "string" },
		"popupDescriptionFontSize": { "type": "string", "default": "20px" },
		"popupDescriptionLetterSpacing": { "type": "string" },
		"popupDescriptionDecoration": { "type": "string" },
		"popupDescriptionLetterCase": { "type": "string" },
		"popupDescriptionLineHeight": { "type": "string" },
		"popupDescriptionFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"popupDescriptionFontStyle": { "type": "string" },
		"popupDescriptionFontWeight": { "type": "string" },

		"popupSkillAlign": { "type": "string" },
		"popupSkillColor": { "type": "string" },
		"popupSkillFontSize": { "type": "string", "default": "20px" },
		"popupSkillLetterSpacing": { "type": "string" },
		"popupSkillDecoration": { "type": "string" },
		"popupSkillLetterCase": { "type": "string" },
		"popupSkillLineHeight": { "type": "string" },
		"popupSkillFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"popupSkillFontStyle": { "type": "string" },
		"popupSkillFontWeight": { "type": "string" },

		"arrowpadding": { "type": "object" },
		"arrowIconSize": { "type": "number", "default": 24 },
		"arrowColor": { "type": "string", "default": "" },
		"arrowBackground": { "type": "string", "default": "" },
		"arrowborder": { "type": "object" },
        "arrowborderRadius": { "type": "string" },

		"buttonAlign": { "type": "string" },
		"buttonBackground": { "type": "string", "default": "" },
		"buttonBGGradient": { "type": "string" },
		"buttonUseIcon": { "type": "boolean", "default": false },
		"buttonIcon": { "type": "string", "default": "fas fa-arrow-right" },
		"buttonIconPosition": { "type": "string", "default": "after" },
		"buttonIconOnHover": { "type": "boolean", "default": false },
		"buttonpadding": { "type": "object", "default": { "top": "10px", "right": "20px", "bottom": "10px", "left": "20px" } },
		"buttonmargin": { "type": "object" },
		"buttonborder": { "type": "object", "default": { "width": "2px", "style": "solid", "color": "#313131" } },
		"buttonborderRadius": { "type": "string", "default": "3px" },
		"buttonColor": { "type": "string" },
		"buttonFontSize": { "type": "string" },
		"buttonLetterSpacing": { "type": "string" },
		"buttonDecoration": { "type": "string" },
		"buttonLetterCase": { "type": "string" },
		"buttonLineHeight": { "type": "string" },
		"buttonFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"buttonFontStyle": { "type": "string" },
		"buttonFontWeight": { "type": "string" },

		"buttonHoverBackground": { "type": "string", "default": "" },
		"buttonHoverBGGradient": { "type": "string" },
		"buttonHoverborder": { "type": "object" },
		"buttonHoverborderRadius": { "type": "string" },
		"buttonHoverColor": { "type": "string" },
		"buttonHoverFontSize": { "type": "string" },
		"buttonHoverLetterSpacing": { "type": "string" },
		"buttonHoverDecoration": { "type": "string" },
		"buttonHoverLetterCase": { "type": "string" },
		"buttonHoverLineHeight": { "type": "string" },
		"buttonHoverFontAppearance": {
			"type": "object",
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"buttonHoverFontStyle": { "type": "string" },
		"buttonHoverFontWeight": { "type": "string" },

		"containerpadding": { "type": "object" },
		"itempadding": { "type": "object" },
		"itemborder": { "type": "object" },
		"itemborderRadius": { "type": "string" },
		"itemBackground": { "type": "string" },
		"itemBGGradient": { "type": "string" }
	},
	"textdomain": "wpmozo-blocks-and-addons",
	"editorScript": "file:./index.js",
	"style": [ "file:./style-index.css" ],
	"script": [ "file:./script.js" ],
	"render": "file:./render.php"
}
