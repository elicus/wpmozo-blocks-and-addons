{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpmozo/facebook-share",
	"version": "0.1.0",
	"title": "Facebook Share",
	"category": "wpmozo",
	"icon": "smiley",
	"description": "Enable users to share your content on Facebook with their facebook accounts.",
	"example": {},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"attributes": {
		"ID": { "type": "string" },
		"className": { "type": "string" },

		"fbAppId": { "type": "string" },
		"pageURL": { "type": "string", "default": "https://wpmozoblocks.com/" },
		"lazyLoading": { "type": "boolean", "default": false },

		"buttonLayout": { "type": "string", "default": "button" },
		"buttonSize": { "type": "string", "default": "small" },
		"buttonAlign": { "type": "string" }
	},
	"textdomain": "wpmozo-blocks-and-addons",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"script": [ "file:./script.js" ]
}
