{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpmozo/portfolio-slider",
	"version": "0.1.0",
	"title": "Portfolio Slider",
	"category": "wpmozo",
	"icon": "portfolio",
	"description": "Showcase portfolio projects beautifully with an interactive portfolio slider.",
	"example": {},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"attributes": {
		"ID": { "type": "string" },
		"className": { "type": "string" },

		"layout": { "type": "string", "default": "layout1" },
		"postsToShow": { "type": "number", "default": 5 },
		"offsetNumber": { "type": "number", "default": 0 },
		"postOrder": { "type": "string", "default": "desc" },
		"postOrderBy": { "type": "string", "default": "date" },
		"includesCategories": { "type": "array", "default": [] },
		"noResultText": { "type": "string", "default": "The portfolios you requested could not be found. Try changing your module settings or create some new portfolios." },

		"showTitle": { "type": "boolean", "default": true },
		"showContent": { "type": "boolean", "default": false },
		"showFeaturedImage": { "type": "boolean", "default": true },
		"showExcerpt": { "type": "boolean", "default": true },
		"excerptLength": { "type": "number", "default": 120 },
		"showReadMore": { "type": "boolean", "default": false },
		"readMoreText": { "type": "string", "default": "Read more" },
		"showProjectUrl": { "type": "boolean", "default": false },
		"projectUrlText": { "type": "string", "default": "View live" },

		"slideEffect": { "type": "string", "default": "slide" },
		"slidesPerView": { "type": "number", "default": 1 },
		"slidesPerViewTablet": { "type": "number", "default": 1 },
		"slidesPerViewMobile": { "type": "number", "default": 1 },
		"slidesPerGroup": { "type": "number", "default": 1 },
		"slidesPerGroupTablet": { "type": "number", "default": 1 },
		"slidesPerGroupMobile": { "type": "number", "default": 1 },
		"spaceBetweenSlides": { "type": "number", "default": 20 },
		"spaceBetweenSlidesTablet": { "type": "number", "default": 20 },
		"spaceBetweenSlidesMobile": { "type": "number", "default": 20 },
		"equalHeight": { "type": "boolean", "default": false },
		"autoHeight": { "type": "boolean", "default": false },
		"enableLoop": { "type": "boolean", "default": false },
		"autoplay": { "type": "boolean", "default": true },
		"enableLinearTrans": { "type": "boolean", "default": false },
		"autoplayDelay": { "type": "number", "default": 3000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"transDuration": { "type": "number", "default": 1000 },

		"enableCoverflowShadow": { "type": "boolean", "default": false },
		"coverflowShadowColor": { "type": "string", "default": "#cccccc" },
		"coverflowRotate": { "type": "number", "default": 40 },
		"coverflowDepth": { "type": "number", "default": 100 },

		"showArrows": { "type": "boolean", "default": false },
		"prevArrowIcon": { "type": "string", "default": "" },
		"nextArrowIcon": { "type": "string", "default": "" },
		"showArrowOnHover": { "type": "boolean", "default": false },
		"arrowsPosition": { "type": "string", "default": "inside" },
		"showControlDot": { "type": "boolean", "default": false },
		"controlDotStyle": { "type": "string", "default": "solid_dot" },
		"enableDynamicDots": { "type": "boolean", "default": false },
		"controlDotColorActive": { "type": "string", "default": "#000000" },
		"controlDotColorInactive": { "type": "string", "default": "#cccccc" },

		"globalTextAlign": { "type": "string", "default": "center" },

		"bodyColor": { "type": "string" },
		"bodyFontSize": { "type": "string" },
		"bodyLetterSpacing": { "type": "string" },
		"bodyDecoration": { "type": "string" },
		"bodyLetterCase": { "type": "string" },
		"bodyLineHeight": { "type": "string" },
		"bodyFontAppearance": { "type": "object", "default": { "fontStyle": "", "fontWeight": "" } },
		"bodyFontStyle": { "type": "string" },
		"bodyFontWeight": { "type": "string" },

		"bodyHoverColor": { "type": "string" },
		"bodyHoverFontSize": { "type": "string" },
		"bodyHoverLetterSpacing": { "type": "string" },
		"bodyHoverDecoration": { "type": "string" },
		"bodyHoverLetterCase": { "type": "string" },
		"bodyHoverLineHeight": { "type": "string" },
		"bodyHoverFontAppearance": { "type": "object", "default": { "fontStyle": "", "fontWeight": "" } },
		"bodyHoverFontStyle": { "type": "string" },
		"bodyHoverFontWeight": { "type": "string" },

		"titleColor": { "type": "string" },
		"titleFontSize": { "type": "string" },
		"titleLetterSpacing": { "type": "string" },
		"titleDecoration": { "type": "string" },
		"titleLetterCase": { "type": "string" },
		"titleLineHeight": { "type": "string" },
		"titleFontAppearance": { "type": "object", "default": { "fontStyle": "", "fontWeight": "" } },
		"titleFontStyle": { "type": "string" },
		"titleFontWeight": { "type": "string" },

		"titleHoverColor": { "type": "string" },
		"titleHoverFontSize": { "type": "string" },
		"titleHoverLetterSpacing": { "type": "string" },
		"titleHoverDecoration": { "type": "string" },
		"titleHoverLetterCase": { "type": "string" },
		"titleHoverLineHeight": { "type": "string" },
		"titleHoverFontAppearance": { "type": "object", "default": { "fontStyle": "", "fontWeight": "" } },
		"titleHoverFontStyle": { "type": "string" },
		"titleHoverFontWeight": { "type": "string" },

		"arrowpadding": { "type": "object" },
		"arrowIconSize": { "type": "number", "default": 24 },
		"arrowColor": { "type": "string", "default": "" },
		"arrowBackground": { "type": "string", "default": "" },
		"arrowborder": { "type": "object" },
		"arrowborderRadius": { "type": "object" },

		"containerpadding": { "type": "object" },

		"featuredImageborder": { "type": "object" },
		"featuredImageborderRadius": { "type": "object" },

		"portfoliopadding": { "type": "object" },
		"portfolioBackground": { "type": "string" },
		"portfolioBGGradient": { "type": "string" },
		"portfolioborder": { "type": "object" },
		"portfolioborderRadius": { "type": "object" }
	},
	"textdomain": "wpmozo-blocks-and-addons",
	"editorScript": "file:./index.js",
	"editorStyle": ["wpmozo-blocks-and-addons-fontawesome-style","file:./index.css"],
	"style": [ "file:./style-index.css", "wpmozo-blocks-and-addons-fontawesome-style", "wpmozo-blocks-and-addons-swiper-style", "wpmozo-blocks-and-addons-swiper-wpmozo-style" ],
	"script": [ "file:./script.js", "wpmozo-blocks-and-addons-swiper-script" ],
	"render": "file:./render.php"
}
