{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpmozo/facebook-like",
	"version": "0.1.0",
	"title": "Facebook Like",
	"category": "wpmozo",
	"icon": "smiley",
	"description": "Add a Facebook Like button to any page, including layout and size options.",
	"example": {},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"attributes": {
		"ID": { "type": "string" },
		"className": { "type": "string" },

		"fbAppId": { "type": "string" },
		"pageURL": { "type": "string", "default": "https://www.facebook.com/facebook/" },
		"lazyLoading": { "type": "boolean", "default": false },

		"buttonLayout": { "type": "string", "default": "button" },
		"buttonSize": { "type": "string", "default": "small" },
		"buttonAlign": { "type": "string" },

		"blockBackground": { "type": "string" },
		"blockBGGradient": { "type": "string" },
		"blockHoverBackground": { "type": "string" },
		"blockHoverBGGradient": { "type": "string" },
		"blockborder": { "type": "object" },
		"blockborderRadius": { "type": "object" },
		"blockHoverborder": { "type": "object" },
		"blockHoverborderRadius": { "type": "object" }
	},

	"textdomain": "wpmozo-blocks-and-addons",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"script": [ "file:./script.js" ]
}
