{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpmozo/fancy-heading",
	"version": "0.1.0",
	"title": "Fancy Heading",
	"category": "wpmozo",
	"icon": "smiley",
	"description": "Add stylish and eye-catching headings to your pages with the Fancy Heading.",
	"example": {},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"attributes": {
		"ID": { "type": "string" },
		"className": { "type": "string" },
		
		"displayInStack": { "type": "boolean", "default": false },
		"headingLevel": { "type": "string", "default": "h2" },
		"headingAlignment": { "type": "string", "default": "" },
		"headingColor": { "type": "string" },
		"headingBackground": { "type": "string" },
		"headingHoverColor": { "type": "string" },
		"headingHoverBackground": { "type": "string" },
		"headingHoverFontSize": { "type": "string" },
		"headingHoverFontAppearance": { "type": "object", "fontStyle": { "type": "string" }, "fontWeight": { "type": "string" }, "default": { "fontStyle": "", "fontWeight": "" } },
		"headingHoverFontStyle": { "type": "string" },
		"headingHoverFontWeight": { "type": "string" },
		"headingHoverLetterSpacing": { "type": "string" },
		"headingHoverDecoration": { "type": "string" },
		"headingHoverLetterCase": { "type": "string" },
		"headingHoverLineHeight": { "type": "string" },
		
		"preHeading": { "type": "string", "default": "Pre" },
		"preTextAlignment": { "type": "string", "default": "" },
		"preTextColor": { "type": "string" },
		"preTextBackground": { "type": "string" },
		"preTextHoverColor": { "type": "string" },
		"preTextHoverBackground": { "type": "string" },
		"preTextDimensionspadding": { "type": "object" },
		"preTextDimensionsmargin": { "type": "object" },
		"preTextFontSize": { "type": "string" },
		"preTextFontAppearance": {
			"type": "object",
			"fontStyle": { "type": "string" },
			"fontWeight": { "type": "string" },
			"default": { "fontStyle": "", "fontWeight": "" }
		},
		"preTextFontStyle": { "type": "string" },
		"preTextFontWeight": { "type": "string" },
		"preTextLetterSpacing": { "type": "string" },
		"preTextDecoration": { "type": "string" },
		"preTextLetterCase": { "type": "string" },
		"preTextLineHeight": { "type": "string" },
		"preTextHoverFontSize": { "type": "string" },
		"preTextHoverFontAppearance": { "type": "object", "fontStyle": { "type": "string" }, "fontWeight": { "type": "string" }, "default": { "fontStyle": "", "fontWeight": "" } },
		"preTextHoverFontStyle": { "type": "string" },
		"preTextHoverFontWeight": { "type": "string" },
		"preTextHoverLetterSpacing": { "type": "string" },
		"preTextHoverDecoration": { "type": "string" },
		"preTextHoverLetterCase": { "type": "string" },
		"preTextHoverLineHeight": { "type": "string" },
		
		"mainHeading": { "type": "string", "default": "Main" },
		"mainTextColor": { "type": "string" },
		"mainTextAlignment": { "type": "string", "default": "" },
		"mainTextBackground": { "type": "string" },
		"mainTextHoverColor": { "type": "string" },
		"mainTextHoverBackground": { "type": "string" },
		"mainTextDimensionspadding": { "type": "object" },
		"mainTextDimensionsmargin": { "type": "object" },
		"mainTextFontSize": { "type": "string" },
		"mainTextFontAppearance": { "type": "object", "fontStyle": { "type": "string" }, "fontWeight": { "type": "string" }, "default": { "fontStyle": "", "fontWeight": "" } },
		"mainTextFontStyle": { "type": "string" },
		"mainTextFontWeight": { "type": "string" },
		"mainTextLetterSpacing": { "type": "string" },
		"mainTextDecoration": { "type": "string" },
		"mainTextLetterCase": { "type": "string" },
		"mainTextLineHeight": { "type": "string" },
		"mainTextHoverFontSize": { "type": "string" },
		"mainTextHoverFontAppearance": { "type": "object", "fontStyle": { "type": "string" }, "fontWeight": { "type": "string" }, "default": { "fontStyle": "", "fontWeight": "" } },
		"mainTextHoverFontStyle": { "type": "string" },
		"mainTextHoverFontWeight": { "type": "string" },
		"mainTextHoverLetterSpacing": { "type": "string" },
		"mainTextHoverDecoration": { "type": "string" },
		"mainTextHoverLetterCase": { "type": "string" },
		"mainTextHoverLineHeight": { "type": "string" },
		
		"postHeading": { "type": "string", "default": "Post" },
		"postTextColor": { "type": "string" },
		"postTextAlignment": { "type": "string", "default": "" },
		"postTextBackground": { "type": "string" },
		"postTextHoverColor": { "type": "string" },
		"postTextHoverBackground": { "type": "string" },
		"postTextDimensionspadding": { "type": "object" },
		"postTextDimensionsmargin": { "type": "object" },
		"postTextFontSize": { "type": "string" },
		"postTextFontAppearance": { "type": "object", "fontStyle": { "type": "string" }, "fontWeight": { "type": "string" }, "default": { "fontStyle": "", "fontWeight": "" } },
		"postTextFontStyle": { "type": "string" },
		"postTextFontWeight": { "type": "string" },
		"postTextLetterSpacing": { "type": "string" },
		"postTextDecoration": { "type": "string" },
		"postTextLetterCase": { "type": "string" },
		"postTextLineHeight": { "type": "string" },
		"postTextHoverFontSize": { "type": "string" },
		"postTextHoverFontAppearance": { "type": "object", "fontStyle": { "type": "string" }, "fontWeight": { "type": "string" }, "default": { "fontStyle": "", "fontWeight": "" } },
		"postTextHoverFontStyle": { "type": "string" },
		"postTextHoverFontWeight": { "type": "string" },
		"postTextHoverLetterSpacing": { "type": "string" },
		"postTextHoverDecoration": { "type": "string" },
		"postTextHoverLetterCase": { "type": "string" },
		"postTextHoverLineHeight": { "type": "string" }
	},
	"textdomain": "wpmozo-blocks-and-addons",
	"editorScript": "file:./index.js"
}
