# WPMozo Pattern Library: local settings for the developer tools and test suites.
#
# Setup guide: docs/pattern-library/testing-environment-setup.md
#
# 1. From the Lite repository root, copy this file to `.env` in this folder, unless `.env` exists:
#      test -e tools/pattern-library/.env || cp tools/pattern-library/.env.example tools/pattern-library/.env
#    `.env` is ignored by Git (the repository's .gitignore); this example is tracked.
# 2. Change the values below for your machine.
# 3. Load it in each new terminal, from the Lite repository root:
#      set -a; . tools/pattern-library/.env; set +a
#
# Shell syntax: NAME="value", no spaces around "=". Quote every value; write $HOME, not ~.
# Never put a password, licence key, cookie or other secret in this file.
# The plugins don't read this file: WordPress resolves their paths and URLs on its own.

# Automated suites (Track A), required: the wp-playground-cli executable (@wp-playground/cli 3.1.58),
# installed outside both repositories.
WPMOZO_PLAYGROUND_CLI="$HOME/.wpmozo-tools/playground/node_modules/.bin/wp-playground-cli"

# Optional for the test suites. Leave them commented out to use the defaults shown.
# The Pro checkout. Default: the folder next to this Lite checkout.
# WPMOZO_PRO_REPO="$HOME/path/to/wpmozo-blocks-and-addons-pro"
# Folder with WordPress release zips named <version>.zip (6.8.11.zip, 7.1.3.zip).
# WPMOZO_WP_ZIPS="$HOME/.wordpress-playground"
# Plugin copies, Playground's home folder, run logs and results. The path must not contain spaces.
# WPMOZO_TEST_CACHE="$HOME/.cache/wpmozo-pattern-library-tests"

# Manual testing (Track B): the URL of the LocalWP site you test on, usually an existing one, as
# Local's site overview shows it (http://<site-domain>, or http://localhost:<port> in Local's
# localhost router mode). No trailing slash. Replace the placeholder; check it with the guide's
# section 8.2. Also used by the authoring tools (export.cjs, gate.cjs). The suites don't need it.
WPMOZO_SITE_URL="http://change-me.local"
# Logged-in browser state for export.cjs and gate.cjs. It holds session cookies: keep it outside
# both repositories.
WPMOZO_AUTH_STATE="$HOME/.wpmozo-authoring/auth.json"
